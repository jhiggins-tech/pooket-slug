# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# The announcer's lines, fetched by CI from the vendor repository's "announcer" release
/Assets/Resources/Voice/
/Assets/Resources/Voice.meta

# Generated by the CI build script (EditorBuildSettings points at it)
/Assets/Scenes/
/Assets/Scenes.meta

# IDE / OS
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.suo
*.user
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.DS_Store
Thumbs.db
__pycache__/
*.pyc

# Crash reports / builds
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage

# Photon Fusion SDK: Photon's license forbids redistributing it, so CI downloads it from a private
# release and unpacks it here (tools/unpack_unitypackage.py). Only our project's Fusion config is committed.
/vendor/
/Assets/Photon.meta
/Assets/Photon/*
!/Assets/Photon/Fusion/
/Assets/Photon/Fusion/*
!/Assets/Photon/Fusion/Resources/
/Assets/Photon/Fusion/Resources/*
!/Assets/Photon/Fusion/Resources/NetworkProjectConfig.fusion

# Photon AppId baked in by the build (from the PHOTON_APP_ID secret)
/Assets/Resources.meta
/Assets/Resources/pooket-net.json
/Assets/Resources/pooket-net.json.meta
/Assets/Resources/Narration/
/Assets/Resources/Narration.meta
/Assets/Resources/Music/
/Assets/Resources/Music.meta
.timetracker

# Browser automation scratch
/.playwright-mcp/
/node_modules/
/playtest/

# What the Unity editor and the build write into the checkout: the scenes built into the game, the
# project settings the editor generates, and the package lock. The CI agent commits what it changed,
# and these are the build's own files, not anyone's work.
/Assets/Resources/Scenes/
/Assets/Resources/Scenes.meta
/Packages/packages-lock.json
/ProjectSettings/*
!/ProjectSettings/ProjectVersion.txt
