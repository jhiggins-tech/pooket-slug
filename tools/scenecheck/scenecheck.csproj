<Project Sdk="Microsoft.NET.Sdk">
  <!-- The scene check (Program.cs): the game's own scene reader, built with plain dotnet, no Unity. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>9.0</LangVersion>
    <NoWarn>CS0618;CS0414;CS0649;CS0169;CS8632</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Core/**/*.cs" />
    <Compile Include="UnityStub.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
